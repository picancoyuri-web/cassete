# gere um valor aleatório e longo, ex: openssl rand -hex 32
JWT_SECRET=

# URL exata do seu site no Netlify (sem barra no final), ex:
# https://cassete.netlify.app
FRONTEND_ORIGIN=http://localhost:5500

# porta em que o backend roda localmente (o Render define isso sozinho em produção)
PORT=3001

# opcional — caminho do arquivo do banco SQLite (padrão: ./data/cassete.db)
# DB_PATH=./data/cassete.db

# ---------- envio de e-mail (recuperação de senha) ----------
# opcional: sem isso configurado, o link de redefinição só aparece no log
# do servidor (dá pra testar assim, mas ninguém recebe e-mail de verdade).
# Exemplo usando Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=seuemail@gmail.com, SMTP_PASS=senha de app (não a senha normal).
# Outras opções fáceis de configurar: Resend, Brevo (Sendinblue), Mailgun.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Cassete <naoresponda@seudominio.com>
